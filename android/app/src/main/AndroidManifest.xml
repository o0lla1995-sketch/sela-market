<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ══════════════════════════════════════════════════════════════
         سيلا ماركت — تطبيق تسوق يحتاج الإنترنت فقط.
         مبدأ جوجل بلاي «أقل الأذونات الممكنة»: لا كاميرا، لا موقع،
         لا بلوتوث، لا تخزين — ثلاثة أذونات لا غير.
         ══════════════════════════════════════════════════════════════ -->
    <!-- تصفح المتاجر والمنتجات وإرسال الطلبات. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- اكتشاف انقطاع الاتصال وإظهار حالة «لا يوجد إنترنت». -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- إشعارات محلية لتغيّرات حالة الطلب (وقت التشغيل على 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- الدخول بالبصمة (v2.1): إذن عادي يُمنح تلقائياً عند التثبيت —
         يلزم لقراءة حالة تسجيل البصمة عبر مدير البصمة على API 28+.
         المصادقة نفسها شاشة قفل النظام، لا تحتاج أي إذن. -->
    <uses-permission android:name="android.permission.USE_BIOMETIC" />
    <!-- أجهزة Android 7–8 القديمة (23–27): إذن البصمة القديم
         المكافئ — بلا وجوده يرفض مدير البصمة هناك. -->
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:supportsRtl="true"
      android:networkSecurityConfig="@xml/network_security_config"
      android:enableOnBackInvokedCallback="false"
      android:theme="@style/AppTheme">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/MarketSplash"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>
      <!-- v2.5: نشاط شفاف يستضيف حوار BiometricPrompt الرسمي
           (يتطلب FragmentActivity) — يظهر كنافذة نظام فوق التطبيق
           ويغلق نفسه فور انتهاء المصادقة. -->
      <activity
        android:name=".native_modules.BiometricDialogActivity"
        android:theme="@style/MarketBiometricDialog"
        android:excludeFromRecents="true"
        android:noHistory="true"
        android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
        android:exported="false" />
    </application>
</manifest>
